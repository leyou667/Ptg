# Clé de l'API Anthropic : conseiller « Quelle formule pour moi ? » (/api/conseil), assistant de la bulle (/api/assistant) et conseiller du questionnaire (/api/advisor).
# Serveur uniquement, jamais exposée au navigateur. Sans clé, « Quelle formule pour moi ? » répond par des règles simples ; les deux assistants disent « indisponible ».
ANTHROPIC_API_KEY=
# Modèle rapide et économique utilisé par l'assistant.
ANTHROPIC_MODEL=claude-haiku-5-5
# Adresse qui reçoit les demandes de devis.
CONTACT_EMAIL=devis@exemple.be
# Envoi des emails via Resend (https://resend.com). Sans clé, la demande est seulement journalisée.
RESEND_API_KEY=
RESEND_FROM=CheyClean <devis@exemple.be>
# Délai de réponse affiché dans la confirmation (à confirmer par CheyClean).
DELAI_REPONSE=24 heures
# URL publique du site (SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.cheyclean.be
# Numéro WhatsApp / téléphone (format international sans +).
NEXT_PUBLIC_WHATSAPP=32486374548

# Stockage des demandes, devis et réglages.
# Recommandé en production (Vercel...) : base PostgreSQL (Neon, Supabase, Vercel Postgres). Les tables sont créées au premier usage.
DATABASE_URL=
# Sans DATABASE_URL : fichiers JSON dans ce dossier (un disque PERSISTANT est nécessaire ; inutilisable sur Vercel).
# Sans aucun stockage utilisable, l'envoi d'une demande est refusé (jamais simulé).
DATA_DIR=./data

# Administration (/admin). Sans ces deux valeurs, l'administration est fermée.
# Générer le hachage : node scripts/hash-password.mjs   (le mot de passe n'est jamais stocké en clair)
ADMIN_PASSWORD_HASH=
# Secret de signature des sessions : au moins 32 caractères aléatoires (openssl rand -base64 48).
ADMIN_SESSION_SECRET=
# Durée d'une session en heures (défaut 8).
ADMIN_SESSION_HOURS=8

# Identité du vendeur : requise pour émettre un jour devis et factures. Laissez vide tant que non défini.
COMPANY_NAME=
COMPANY_FORM=
COMPANY_STREET=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_COUNTRY=Belgique
COMPANY_VAT=
COMPANY_IBAN=
COMPANY_EMAIL=
COMPANY_PHONE=
