# Clé de l'API Anthropic (assistant IA). Serveur uniquement, jamais exposée au navigateur.
ANTHROPIC_API_KEY=
# Modèle rapide et économique utilisé par l'assistant.
ANTHROPIC_MODEL=claude-haiku-5-5
# Adresse qui reçoit les demandes de devis.
CONTACT_EMAIL=devis@exemple.be
# Envoi des emails via Resend (https://resend.com). Sans clé, la demande est seulement journalisée.
RESEND_API_KEY=
RESEND_FROM=CheyClean <devis@exemple.be>
# Délai de réponse affiché dans la confirmation (à confirmer par CheyClean).
DELAI_REPONSE=24 heures
# URL publique du site (SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.cheyclean.be
# Numéro WhatsApp / téléphone (format international sans +).
NEXT_PUBLIC_WHATSAPP=32486374548
